# LogLens configuration. Copy to .env (run.sh setup does this for you).
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4109
WEB_PORT=5109
WEB_ORIGIN=http://localhost:5109
LOG_LEVEL=info

# Local PostgreSQL over the unix socket in /tmp, current OS user, no password.
DATABASE_URL=postgresql:///loglens_dev?host=/tmp
TEST_DATABASE_URL=postgresql:///loglens_test?host=/tmp

# 64 hex chars; run.sh generates a random value.
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_TTL_HOURS=12

# Query engine guard rails
QUERY_TIMEOUT_MS=5000
QUERY_MAX_ROWS=10000

# Ingestion guard rails
INGEST_MAX_BODY_BYTES=5242880
INGEST_MAX_EVENTS_PER_REQUEST=5000
